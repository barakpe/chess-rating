# --- Committed test fixture: a tiny synthetic dump so the ingest smoke test
#     is reproducible WITHOUT the 30 GB monthly download. These exceptions must
#     come AFTER the *.pgn / *.zst ignores above to take effect. ---
!tests/fixtures/
!tests/fixtures/*.pgn
!tests/fixtures/*.pgn.zst
